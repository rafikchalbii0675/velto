generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}

model Merchant {
  id String @id @default(cuid())
  shopDomain String @unique
  points Int @default(0)
  createdAt DateTime @default(now())
}

model Sponsor {
  id String @id
  name String
  status String
  pointsCost Int
}

model PointsLedger {
  id String @id @default(cuid())
  merchantId String
  delta Int
  reason String
  createdAt DateTime @default(now())

  @@index([merchantId])
}