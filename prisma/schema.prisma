datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Points {
  id        String   @id @default(cuid())
  shopId    String   @unique
  total     Int      @default(0)
  month     Int      @default(0)
  level     String   @default("Bronze Cozy")
  updatedAt DateTime @updatedAt
}

model Logs {
  id      String   @id @default(cuid())
  type    String
  message String
  date    String
}

model Shop {
  id        String   @id @default(cuid())
  shopId    String   @unique
  createdAt DateTime @default(now())
}

model CryptoSale {
  id        String   @id @default(cuid())
  shopId    String
  amount    Float
  currency  String
  txId      String   @unique
  createdAt DateTime @default(now())
}

model Notification {
  id        String   @id @default(cuid())
  shopId    String
  type      String
  message   String
  createdAt DateTime @default(now())
}

model User {
  id        String     @id @default(cuid())
  email     String     @unique
  password  String?
  name      String?
  shopId    String?
  roleId    String?
  role      VeltoRole? @relation(fields: [roleId], references: [id])
  createdAt DateTime   @default(now())
}

model Product {
  id        String   @id @default(cuid())
  shopId    String
  title     String
  price     Float
  sales     Int      @default(0)
  score     Float    @default(0)
  createdAt DateTime @default(now())
}

model Alert {
  id        String   @id @default(cuid())
  shopId    String
  type      String
  message   String
  severity  String
  createdAt DateTime @default(now())
}

model SecurityLog {
  id        String   @id @default(cuid())
  shopId    String
  type      String
  message   String
  severity  String
  createdAt DateTime @default(now())
}

model IAPoints {
  id        String   @id @default(cuid())
  shopId    String
  points    Int      @default(0)
  level     String   @default("beginner")
  progress  Int      @default(0)
  updatedAt DateTime @updatedAt
}

model IAReward {
  id          String  @id @default(cuid())
  level       String
  title       String
  description String
  value       Int?
  partnerId   String?
}

model IAPartnerOffer {
  id          String   @id @default(cuid())
  partnerName String
  minLevel    String
  offerTitle  String
  offerValue  Int?
  offerType   String
}

model Partner {
  id          String         @id @default(cuid())
  name        String
  category    String
  description String?
  logoUrl     String?
  createdAt   DateTime       @default(now())
  offers      PartnerOffer[] @relation("PartnerOffers")
}

model PartnerOffer {
  id          String   @id @default(cuid())
  partnerId   String
  minLevel    String
  title       String
  description String
  value       Int?
  type        String
  createdAt   DateTime @default(now())

  partner Partner @relation("PartnerOffers", fields: [partnerId], references: [id])
}

model IAWallet {
  id        String   @id @default(cuid())
  shopId    String
  points    Int      @default(0)
  rewards   Int      @default(0)
  createdAt DateTime @default(now())
}

model IATransaction {
  id        String   @id @default(cuid())
  shopId    String
  type      String
  title     String
  amount    Int
  createdAt DateTime @default(now())
}

model IANotification {
  id        String   @id @default(cuid())
  shopId    String
  type      String
  title     String
  message   String
  createdAt DateTime @default(now())
  read      Boolean  @default(false)
}

model IACoaching {
  id        String   @id @default(cuid())
  shopId    String
  level     String
  advice    String
  createdAt DateTime @default(now())
}

model IASuccess {
  id          String   @id @default(cuid())
  shopId      String
  type        String
  title       String
  description String
  createdAt   DateTime @default(now())
}

model VeltoRole {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  users     User[]
}

model OwnerPoints {
  id        String   @id @default(cuid())
  ownerId   String
  points    Int      @default(0)
  level     String   @default("creator")
  progress  Int      @default(0)
  createdAt DateTime @default(now())
}

model OwnerReward {
  id        String   @id @default(cuid())
  ownerId   String
  title     String
  type      String
  createdAt DateTime @default(now())
}
model Session {
  id          String   @id @default(cuid())
  shop        String
  state       String
  isOnline    Boolean
  scope       String?
  expiresAt   DateTime?
  accessToken String?
}
