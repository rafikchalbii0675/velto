    "@remix-run/serve": "^2.16.1",
    "@shopify/app-bridge-react": "^3.7.10",
    "@shopify/polaris": "^12.0.0",
    "@shopify/shopify-api": "^13.1.0",
    "@shopify/shopify-app-remix": "^4.2.1",
    "@shopify/shopify-app-session-storage-prisma": "^6.0.9",
    "bcryptjs": "^3.0.3",
    "chart.js": "^4.5.1",
    "isbot": "^5.2.2",
    "openai": "^6.49.0",
    "prisma": "^6.12.0",
    "react": "^18.2.0",
    "react-chartjs-2": "^5.3.1",
